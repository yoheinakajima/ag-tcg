modules = ["python-3.11", "nodejs-20"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["javascript_object_storage:2.0.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pass36_42"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pass36_43_regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pass36_44_regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pass36_45_regression"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 main.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "pass36_42"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m pytest tests/test_pass36_tournament_engine.py tests/test_pass37_deployment_storage.py tests/test_pass38_deployment_ops.py tests/test_pass39_candidate_lifecycle.py tests/test_pass40_reference_intake.py tests/test_pass41_cg_typed_candidate.py tests/test_pass42_candidate_generation.py -q"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "pass36_43_regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m pytest tests/test_pass36_tournament_engine.py tests/test_pass37_deployment_storage.py tests/test_pass38_deployment_ops.py tests/test_pass39_candidate_lifecycle.py tests/test_pass40_reference_intake.py tests/test_pass41_cg_typed_candidate.py tests/test_pass42_candidate_generation.py tests/test_pass43_promotion_gate.py -q"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "pass36_44_regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m pytest tests/test_pass36_tournament_engine.py tests/test_pass37_deployment_storage.py tests/test_pass38_deployment_ops.py tests/test_pass39_candidate_lifecycle.py tests/test_pass40_reference_intake.py tests/test_pass41_cg_typed_candidate.py tests/test_pass42_candidate_generation.py tests/test_pass43_promotion_gate.py tests/test_pass44_post_republish_registration.py -q"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "pass36_45_regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 -m pytest tests/test_pass36_tournament_engine.py tests/test_pass37_deployment_storage.py tests/test_pass38_deployment_ops.py tests/test_pass39_candidate_lifecycle.py tests/test_pass40_reference_intake.py tests/test_pass41_cg_typed_candidate.py tests/test_pass42_candidate_generation.py tests/test_pass43_promotion_gate.py tests/test_pass44_post_republish_registration.py tests/test_pass45_probation_soak.py -q"

[workflows.workflow.metadata]
outputType = "console"

[deployment]
deploymentTarget = "scheduled"
run = ["python", "scripts/tournament_deployment_tick.py", "--max-games", "20", "--max-seconds", "900", "--storage-backend", "replit_app_storage", "--production"]
build = ["python", "-m", "pip", "install", "--user", "--break-system-packages", "replit-object-storage", "pyyaml", "kaggle-environments==1.30.1"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
