modules = ["python-3.11", "nodejs-20"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["javascript_object_storage:2.0.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 main.py"

[workflows.workflow.metadata]
outputType = "console"

[deployment]
deploymentTarget = "scheduled"
run = ["python", "scripts/tournament_deployment_tick.py", "--max-games", "20", "--max-seconds", "900", "--storage-backend", "replit_app_storage", "--production"]
build = ["python", "-m", "pip", "install", "--break-system-packages", "replit-object-storage", "pyyaml"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
